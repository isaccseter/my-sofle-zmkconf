#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&soft_off { hold-time-ms = <2000>; };

&sl { release-after-ms = <2000>; };

&mt {
    flavor = "balanced";
    hold-trigger-on-release;
    tapping-term-ms = <250>;
};

/ {
    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    Llt: Llt {
        compatible = "zmk,behavior-hold-tap";
        label = "LLT";
        bindings = <&mo>, <&kp>;

        #binding-cells = <2>;
        tapping-term-ms = <200>;
        quick-tap-ms = <150>;
        require-prior-idle-ms = <125>;
        flavor = "balanced";
        hold-trigger-key-positions = <53 54 55 56 57 7 8 9 10 11 12 20 21 22 23 24 25 33 34 35 36 37 38 46 47 48 49 50 51 60 61 62 63 59>;
        hold-trigger-on-release;
    };

    Rlt: Rlt {
        compatible = "zmk,behavior-hold-tap";
        label = "RLT";
        bindings = <&mo>, <&kp>;

        #binding-cells = <2>;
        tapping-term-ms = <200>;
        quick-tap-ms = <150>;
        require-prior-idle-ms = <125>;
        flavor = "balanced";
        hold-trigger-key-positions = <53 54 55 56 57 59 0 1 13 14 15 16 17 18 26 27 28 29 30 31 39 40 41 42 43 44 53 54 55 2 3 4 5 60 61 62 63>;
        hold-trigger-on-release;
    };

    Lmt: Lmt {
        compatible = "zmk,behavior-hold-tap";
        label = "LMT";
        bindings = <&kp>, <&kp>;

        #binding-cells = <2>;
        tapping-term-ms = <200>;
        quick-tap-ms = <150>;
        require-prior-idle-ms = <125>;
        flavor = "balanced";
        hold-trigger-key-positions = <53 54 55 56 57 7 8 9 10 11 12 20 21 22 23 24 25 33 34 35 36 37 38 46 47 48 49 50 51 60 61 62 63 59>;
        hold-trigger-on-release;
    };

    Rmt: Rmt {
        compatible = "zmk,behavior-hold-tap";
        label = "RMT";
        bindings = <&kp>, <&kp>;

        #binding-cells = <2>;
        tapping-term-ms = <200>;
        quick-tap-ms = <150>;
        require-prior-idle-ms = <125>;
        flavor = "balanced";
        hold-trigger-key-positions = <53 54 55 56 57 59 0 1 13 14 15 16 17 18 26 27 28 29 30 31 39 40 41 42 43 44 53 54 55 2 3 4 5 60 61 62 63>;
        hold-trigger-on-release;
    };

    tog_ctrl: tog_ctrl {
        compatible = "zmk,behavior-hold-tap";
        label = "TOG_CTRL";
        bindings = <&kp>, <&kp>;

        #binding-cells = <2>;
        tapping-term-ms = <250>;
        flavor = "balanced";
        hold-while-undecided;
    };

    behaviors {
    };

    combos {
        compatible = "zmk,combos";

        Copy {
            bindings = <&kp LC(LS(C))>;
            key-positions = <2 3>;
        };

        Paste {
            bindings = <&kp LC(LS(V))>;
            key-positions = <3 4>;
        };

        Undo {
            bindings = <&kp LC(Z)>;
            key-positions = <13 14>;
        };

        soft_off {
            bindings = <&soft_off>;
            key-positions = <39 40>;
        };

        double_return {
            bindings = <&double_return>;
            key-positions = <48 49>;
            timeout-ms = <300>;
            layers = <0 1 2 3 6>;
        };

        under {
            bindings = <&alt_under>;
            key-positions = <48 47>;
            timeout-ms = <300>;
        };

        CE_space {
            bindings = <&CE_space>;
            key-positions = <56 60>;
            timeout-ms = <300>;
        };

        copy_name {
            bindings = <&rename_Ca_Cc>;
            key-positions = <48 49>;
            layers = <4>;
            timeout-ms = <300>;
        };
    };

    macros {
        double_return: double_return {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RETURN &kp RETURN>;
            label = "DOUBLE_RETURN";
        };

        CE_space: CE_space {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SPACE &kp SPACE &kp LC(SPACE)>;
            label = "CE_SPACE";
        };

        sel_row: sel_row {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp HOME &kp LS(END)>;
            label = "SEL_ROW";
        };

        rename_Ca_Cc: rename_Ca_Cc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp F2 &kp LC(A) &kp LC(C)>;
            label = "RENAME_CA_CC";
        };

        triple_up: trple_up {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp UP_ARROW &kp UP_ARROW &kp UP_ARROW>;
            label = "TRPLE_UP";
        };

        triple_down: triple_down {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DOWN &kp DOWN &kp DOWN>;
            label = "TRIPLE_DOWN";
        };

        five_left: five_left {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT &kp LEFT &kp LEFT &kp LEFT &kp LEFT>;
            label = "FIVE_LEFT";
        };

        five_right: five_right {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RIGHT &kp RIGHT &kp RIGHT &kp RIGHT &kp RIGHT>;
            label = "FIVE_RIGHT";
        };

        alt_backslash: alt_backslash {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_N9 &kp KP_N2>,
                <&macro_release>,
                <&kp LALT>;

            label = "ALT_BACKSLASH";
        };

        alt_grave: alt_grave {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_N9 &kp KP_N6>,
                <&macro_release>,
                <&kp LALT>;

            label = "ALT_GRAVE";
        };

        alt_under: alt_under {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_N9 &kp KP_N5>,
                <&macro_release>,
                <&kp LALT>;

            label = "ALT_UNDER";
        };

        end_SEMICOLON_Return: end_SEMICOLON_Return {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp END &kp SEMICOLON &kp RETURN>;
            label = "END_SEMICOLON_RETURN";
        };

        SEMICOLON_Return: SEMICOLON_Return {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SEMICOLON &kp RETURN>;
            label = "SEMICOLON_RETURN";
        };

        end_Return: end_Return {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp END &kp RETURN>;
            label = "END_RETURN";
        };

        caret_quote: caret_quote {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp CARET &kp DQT>;
            label = "CARET_QUOTE";
        };

        question_quote: question_quote {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp QUESTION &kp DQT>;
            label = "QUESTION_QUOTE";
        };

        exclamation_quote: exclamation_quote {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp EXCLAMATION &kp DQT>;
            label = "EXCLAMATION_QUOTE";
        };

        colon_quote: colon_quote {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp COLON &kp DQT>;
            label = "COLON_QUOTE";
        };

        comma_quote: comma_quote {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp COMMA &kp DQT>;
            label = "COMMA_QUOTE";
        };

        dot_quote: dot_quote {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DOT &kp DQT>;
            label = "DOT_QUOTE";
        };

        triple_minus: triple_minus {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp MINUS &kp MINUS &kp MINUS>;
            label = "TRIPLE_MINUS";
        };

        pair_alt_grave: pair_grave {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_N9 &kp KP_N6>,
                <&macro_release>,
                <&kp LALT>,
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_N9 &kp KP_N6>,
                <&macro_release>,
                <&kp LALT>,
                <&macro_wait_time 30>,
                <&macro_tap>,
                <&kp LEFT>;

            label = "PAIR_GRAVE";
        };

        double_alt_leftBracket: double_alt_leftBracket {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_N9 &kp KP_N1>,
                <&macro_release>,
                <&kp LALT>,
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_N9 &kp KP_N1>,
                <&macro_release>,
                <&kp LALT>;

            label = "DOUBLE_ALT_LEFTBRACKET";
        };

        Return_quote: Return_quote {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RETURN &kp DQT>;
            label = "RETURN_QUOTE";
        };

        pair_quote: pair_quote {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp DOUBLE_QUOTES &kp DQT>,
                <&macro_wait_time 30>,
                <&kp LEFT>;

            label = "PAIR_QUOTE";
        };

        pair_apostrophe: pair_apostrophe {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp APOSTROPHE &kp APOSTROPHE>,
                <&macro_wait_time 30>,
                <&kp LEFT>;

            label = "PAIR_APOSTROPHE";
        };

        mo26: mo26 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&tog 6>,
                <&macro_press>,
                <&mo 2>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&mo 2>;

            label = "MO26";
        };

        signature: signature {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp D &kp Y &kp C &kp A &kp L &kp O &kp R>;
            label = "SIGNATURE";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Default {
            bindings = <
&mkp MB3         &kp LC(X)       &kp LC(V)      &kp LC(C)                    &kp LC(A)     &kp DELETE         &kp UP_ARROW     &kp HOME         &kp LEFT      &kp RIGHT     &kp BSPC       &kp END           &kp C_PLAY_PAUSE
&mt LA(TAB) TAB  &kp Q           &Llt 5 W       &Llt 1 E                     &kp R         &kp T              &kp DOWN_ARROW   &kp Y            &kp U         &Rlt 1 I      &kp O          &kp P             &kp FSLH
&kp LC(SPACE)    &kp A           &Lmt LSHIFT S  &Llt 2 D                     &Lmt LCTRL F  &Lmt LS(LALT) G    &kp LEFT_ARROW   &Rmt RS(RALT) H  &Rmt RCTRL J  &Rlt 3 K      &Rmt RSHIFT L  &kp ENTER         &kp MINUS
&kp ESC          &kp Z           &Lmt LALT X    &Llt 4 C                     &Llt 6 V      &kp B              &kp RIGHT_ARROW  &kp N            &kp M         &Rlt 5 COMMA  &Rmt RALT DOT  &kp SINGLE_QUOTE  &kp CAPS
&kp C_MUTE       &msc SCRL_DOWN  &msc SCRL_UP   &tog_ctrl LCTRL PRINTSCREEN  &kp SPACE     &sl 5              &kp ENTER        &kp LGUI         &kp SPACE     &kp LC(END)   &kp BACKSLASH  &kp GRAVE
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
            display-name = "LAYER0";
            label = "默认层";
        };

        Symbols {
            bindings = <
&trans  &trans           &trans           &alt_backslash    &trans             &trans                    &trans  &trans             &trans                      &alt_backslash         &trans           &trans             &trans
&trans  &alt_grave       &kp LESS_THAN    &kp GREATER_THAN  &kp MINUS          &kp PIPE                  &trans  &kp CARET          &kp LEFT_BRACE              &kp RIGHT_BRACE        &kp DLLR         &kp UNDER          &trans
&trans  &kp EXCLAMATION  &mt LSHIFT STAR  &kp FSLH          &mt LCTRL EQUAL    &mt LS(LALT) AMPERSAND    &trans  &mt RS(RALT) HASH  &mt RCTRL LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &mt RSHIFT SEMI  &kp DOUBLE_QUOTES  &trans
&trans  &kp TILDE        &mt LALT PLUS    &kp LBKT          &kp RIGHT_BRACKET  &kp PERCENT               &trans  &kp AT_SIGN        &kp COLON                   &kp QUESTION           &mt RALT EXCL    &kp SQT            &trans
&trans  &trans           &trans           &trans            &trans             &trans                    &trans  &trans             &trans                      &to 0                  &trans           &trans
            >;

            label = "符号";
        };

        Navigation {
            bindings = <
&trans  &trans  &trans      &trans  &trans     &trans          &trans  &sel_row   &kp LC(INS)       &kp LS(INS)        &trans             &trans     &trans
&trans  &trans  &kp DELETE  &trans  &trans     &trans          &trans  &kp PG_UP  &kp HOME          &kp UP             &kp END            &kp LC(F)  &trans
&trans  &trans  &kp LSHFT   &mo 2   &kp LCTRL  &kp LS(LALT)    &trans  &kp PG_DN  &kp LEFT          &kp DOWN           &kp RIGHT          &trans     &trans
&trans  &trans  &kp LALT    &trans  &mo 6      &trans          &trans  &kp LC(Z)  &kp LS(LC(LEFT))  &kp K_APPLICATION  &kp LC(LS(RIGHT))  &kp INS    &trans
&trans  &trans  &trans      &trans  &trans     &trans          &trans  &trans     &trans            &to 0              &trans             &trans
            >;

            label = "导航";
        };

        Number {
            bindings = <
&trans  &trans     &kp E   &kp COMMA  &kp PERCENT   &trans      &trans  &trans        &trans     &trans  &trans     &trans  &trans
&trans  &kp FSLH   &kp N7  &kp N8     &kp N9        &kp STAR    &trans  &trans        &trans     &trans  &trans     &trans  &trans
&trans  &kp MINUS  &kp N4  &kp N5     &kp N6        &kp N0      &trans  &kp RS(RALT)  &kp RCTRL  &trans  &kp RSHFT  &trans  &trans
&trans  &kp X      &kp N1  &kp N2     &kp NUMBER_3  &kp PLUS    &trans  &trans        &kp DOT    &trans  &kp RALT   &trans  &trans
&trans  &trans     &trans  &trans     &trans        &trans      &trans  &trans        &trans     &to 0   &trans     &trans
            >;

            label = "数字";
        };

        Fkey_mouse {
            bindings = <
&trans  &trans     &trans        &trans     &trans        &trans       &trans  &trans              &kp PRINTSCREEN  &kp SYSREQ  &kp INS  &kp SCROLLLOCK  &trans
&trans  &trans     &trans        &trans     &trans        &trans       &trans  &kp F12             &kp F7           &kp F8      &kp F9   &trans          &trans
&trans  &trans     &kp LEFT_ALT  &mkp RCLK  &kp LS(LALT)  &trans       &trans  &kp LC(LA(LS(F8)))  &kp F4           &kp F5      &kp F6   &kp F10         &trans
&trans  &mkp MCLK  &kp LSHIFT    &mkp LCLK  &kp LCTRL     &mkp MCLK    &trans  &kp F11             &kp F1           &kp F2      &kp F3   &trans          &trans
&trans  &trans     &trans        &tog 4     &trans        &trans       &trans  &trans              &trans           &to 0       &trans   &trans
            >;

            label = "功能区和鼠标";
        };

        APP_flash {
            bindings = <
&rgb_ug RGB_TOG  &to 1           &to 2           &to 3           &to 4           &to 6                &trans  &trans                 &trans                   &kp KP_NUMLOCK   &trans              &trans            &trans
&rgb_ug RGB_EFF  &kp LG(LC(N9))  &kp LA(LEFT)    &kp LA(RIGHT)   &kp F5          &kp C_VOLUME_UP      &trans  &end_SEMICOLON_Return  &caret_quote             &question_quote  &exclamation_quote  &pair_alt_grave   &trans
&kp C_BRI_UP     &kp LG(D)       &kp LG(LC(N1))  &kp LG(LC(N2))  &kp LG(LC(N3))  &kp C_VOLUME_DOWN    &trans  &SEMICOLON_Return      &colon_quote             &comma_quote     &dot_quote          &end_Return       &triple_minus
&kp C_BRI_DEC    &rename_Ca_Cc   &kp LG(LC(N4))  &kp LG(LC(N5))  &kp LG(LC(N6))  &kp C_MUTE           &trans  &pair_alt_grave        &double_alt_leftBracket  &Return_quote    &pair_quote         &pair_apostrophe  &trans
&trans           &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_CLR_ALL  &trans               &trans  &trans                 &trans                   &to 0            &trans              &trans
            >;

            label = "窗口和快捷功能";
        };

        spNav {
            bindings = <
&trans  &trans  &trans     &trans  &trans     &trans          &trans  &trans  &trans      &trans        &trans       &trans  &trans
&trans  &trans  &trans     &trans  &trans     &trans          &trans  &trans  &trans      &triple_up    &trans       &trans  &trans
&trans  &trans  &kp LSHFT  &mo26   &kp LCTRL  &kp LS(LALT)    &trans  &trans  &five_left  &triple_down  &five_right  &trans  &trans
&trans  &trans  &kp LALT   &trans  &mo 6      &trans          &trans  &trans  &trans      &trans        &trans       &trans  &trans
&trans  &trans  &trans     &trans  &trans     &trans          &trans  &trans  &trans      &trans        &trans       &trans
            >;

            label = "特殊导航";
        };
    };
};
