#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&soft_off { hold-time-ms = <2000>; };

&sl { release-after-ms = <2000>; };

&mt {
    flavor = "balanced";
    hold-trigger-on-release;
    tapping-term-ms = <250>;
};

/ {
    Llt: Llt {
        compatible = "zmk,behavior-hold-tap";
        label = "LLT";
        bindings = <&mo>, <&kp>;

        #binding-cells = <2>;
        tapping-term-ms = <200>;
        quick-tap-ms = <150>;
        require-prior-idle-ms = <125>;
        flavor = "balanced";
        hold-trigger-key-positions = <53 54 55 56 57 7 8 9 10 11 12 20 21 22 23 24 25 33 34 35 36 37 38 46 47 48 49 50 51 60 61 62 63 59>;
        hold-trigger-on-release;
    };

    Rlt: Rlt {
        compatible = "zmk,behavior-hold-tap";
        label = "RLT";
        bindings = <&mo>, <&kp>;

        #binding-cells = <2>;
        tapping-term-ms = <200>;
        quick-tap-ms = <150>;
        require-prior-idle-ms = <125>;
        flavor = "balanced";
        hold-trigger-key-positions = <53 54 55 56 57 59 0 1 13 14 15 16 17 18 26 27 28 29 30 31 39 40 41 42 43 44 53 54 55 2 3 4 5 60 61 62 63>;
        hold-trigger-on-release;
    };

    Lmt: Lmt {
        compatible = "zmk,behavior-hold-tap";
        label = "LMT";
        bindings = <&kp>, <&kp>;

        #binding-cells = <2>;
        tapping-term-ms = <200>;
        quick-tap-ms = <150>;
        require-prior-idle-ms = <125>;
        flavor = "balanced";
        hold-trigger-key-positions = <53 54 55 56 57 7 8 9 10 11 12 20 21 22 23 24 25 33 34 35 36 37 38 46 47 48 49 50 51 60 61 62 63 59>;
        hold-trigger-on-release;
    };

    Rmt: Rmt {
        compatible = "zmk,behavior-hold-tap";
        label = "RMT";
        bindings = <&kp>, <&kp>;

        #binding-cells = <2>;
        tapping-term-ms = <200>;
        quick-tap-ms = <150>;
        require-prior-idle-ms = <125>;
        flavor = "balanced";
        hold-trigger-key-positions = <53 54 55 56 57 59 0 1 13 14 15 16 17 18 26 27 28 29 30 31 39 40 41 42 43 44 53 54 55 2 3 4 5 60 61 62 63>;
        hold-trigger-on-release;
    };

    ptsrn_ctrl: ptsrn_ctrl {
        compatible = "zmk,behavior-hold-tap";
        label = "PTSRN_CTRL";
        bindings = <&kp>, <&kp>;

        #binding-cells = <2>;
        tapping-term-ms = <250>;
        flavor = "balanced";
        hold-while-undecided;
    };

    de_semicolon: de_semicolon {
        compatible = "zmk,behavior-mod-morph";
        label = "DE_SEMICOLON";
        bindings = <&kp COLON>, <&kp SEMI>;

        #binding-cells = <0>;
        mods = <(MOD_LSFT|MOD_RSFT)>;
    };

    hold_space: hold_space {
        compatible = "zmk,behavior-hold-tap";
        label = "HOLD_SPACE";
        bindings = <&mo>, <&kp>;

        #binding-cells = <2>;
        tapping-term-ms = <200>;
        quick-tap-ms = <150>;
        require-prior-idle-ms = <125>;
        flavor = "balanced";
        hold-trigger-on-release;
    };

    copy: copy {
        compatible = "zmk,behavior-tap-dance";
        label = "COPY";
        #binding-cells = <0>;
        bindings = <&kp LC(C)>, <&kp LC(LS(C))>;
    };

    paste: paste {
        compatible = "zmk,behavior-tap-dance";
        label = "PASTE";
        #binding-cells = <0>;
        bindings = <&kp LC(LS(V))>, <&kp LC(V)>;
    };

    behaviors {
    };

    combos {
        compatible = "zmk,combos";

        Undo {
            bindings = <&kp LC(Z)>;
            key-positions = <2 3>;
        };

        soft_off {
            bindings = <&soft_off>;
            key-positions = <39 40>;
        };

        de_semicolon {
            bindings = <&de_semicolon>;
            key-positions = <48 49>;
            timeout-ms = <300>;
            layers = <0>;
        };
    };

    macros {
        double_return: double_return {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RETURN &kp RETURN>;
            label = "DOUBLE_RETURN";
        };

        CE_space: CE_space {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SPACE &kp SPACE &kp LC(SPACE)>;
            label = "CE_SPACE";
        };

        sel_row: sel_row {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp HOME &kp LS(END)>;
            label = "SEL_ROW";
        };

        rename_Ca_Cc: rename_Ca_Cc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp F2 &kp LC(A) &kp LC(C)>;
            label = "RENAME_CA_CC";
        };

        alt_backslash: alt_backslash {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_N9 &kp KP_N2>,
                <&macro_release>,
                <&kp LALT>;

            label = "ALT_BACKSLASH";
        };

        alt_grave: alt_grave {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_N9 &kp KP_N6>,
                <&macro_release>,
                <&kp LALT>;

            label = "ALT_GRAVE";
        };

        alt_under: alt_under {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_N9 &kp KP_N5>,
                <&macro_release>,
                <&kp LALT>;

            label = "ALT_UNDER";
        };

        end_SEMICOLON_Return: end_SEMICOLON_Return {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp END &kp SEMICOLON &kp RETURN>;
            label = "END_SEMICOLON_RETURN";
        };

        SEMICOLON_Return: SEMICOLON_Return {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SEMICOLON &kp RETURN>;
            label = "SEMICOLON_RETURN";
        };

        end_Return: end_Return {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp END &kp RETURN>;
            label = "END_RETURN";
        };

        caret_quote: caret_quote {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp CARET &kp DQT>;
            label = "CARET_QUOTE";
        };

        question_quote: question_quote {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp QUESTION &kp DQT>;
            label = "QUESTION_QUOTE";
        };

        exclamation_quote: exclamation_quote {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp EXCLAMATION &kp DQT>;
            label = "EXCLAMATION_QUOTE";
        };

        colon_quote: colon_quote {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp COLON &kp DQT>;
            label = "COLON_QUOTE";
        };

        comma_quote: comma_quote {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp COMMA &kp DQT>;
            label = "COMMA_QUOTE";
        };

        dot_quote: dot_quote {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DOT &kp DQT>;
            label = "DOT_QUOTE";
        };

        triple_minus: triple_minus {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp MINUS &kp MINUS &kp MINUS>;
            label = "TRIPLE_MINUS";
        };

        pair_alt_grave: pair_grave {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_N9 &kp KP_N6>,
                <&macro_release>,
                <&kp LALT>,
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_N9 &kp KP_N6>,
                <&macro_release>,
                <&kp LALT>,
                <&macro_wait_time 30>,
                <&macro_tap>,
                <&kp LEFT>;

            label = "PAIR_GRAVE";
        };

        double_alt_leftBracket: double_alt_leftBracket {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_N9 &kp KP_N1>,
                <&macro_release>,
                <&kp LALT>,
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_N9 &kp KP_N1>,
                <&macro_release>,
                <&kp LALT>;

            label = "DOUBLE_ALT_LEFTBRACKET";
        };

        Return_quote: Return_quote {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RETURN &kp DQT>;
            label = "RETURN_QUOTE";
        };

        pair_quote: pair_quote {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp DOUBLE_QUOTES &kp DQT>,
                <&macro_wait_time 30>,
                <&kp LEFT>;

            label = "PAIR_QUOTE";
        };

        pair_apostrophe: pair_apostrophe {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp APOSTROPHE &kp APOSTROPHE>,
                <&macro_wait_time 30>,
                <&kp LEFT>;

            label = "PAIR_APOSTROPHE";
        };

        signature: signature {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(D) &kp Y &kp C &kp A &kp L &kp O &kp R>;
            label = "SIGNATURE";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Default {
            bindings = <
&kp MINUS           &kp EQUAL         &paste           &copy                          &kp INSERT           &kp DELETE              &kp UP_ARROW     &kp HOME             &kp LEFT              &kp RIGHT           &kp END           &kp BACKSPACE          &kp C_PLAY_PAUSE
&kp TAB             &kp Q             &Lmt LEFT_GUI W  &kp E                          &kp R                &kp T                   &kp DOWN_ARROW   &kp Y                &kp U                 &kp I               &Rmt RIGHT_GUI O  &kp P                  &kp FSLH
&kp LS(LA(LC(F8)))  &Lmt LEFT_ALT A   &Llt 3 S         &Lmt LEFT_SHIFT D              &Lmt LEFT_CONTROL F  &kp G                   &kp LEFT_ARROW   &kp H                &Rmt RIGHT_CONTROL J  &Rmt RIGHT_SHIFT K  &Rlt 3 L          &Rmt RIGHT_ALT RETURN  &kp MINUS
&double_return      &kp Z             &kp X            &kp C                          &kp V                &kp B                   &kp RIGHT_ARROW  &kp N                &kp M                 &kp COMMA           &kp DOT           &kp FSLH               &kp APOS
&kp C_MUTE          &kp LEFT_BRACKET  &kp RBKT         &ptsrn_ctrl LCTRL PRINTSCREEN  &hold_space 1 SPACE  &hold_space 4 ESCAPE    &kp ENTER        &hold_space 5 UNDER  &hold_space 2 SPACE   &kp F24             &kp CAPSLOCK      &kp GRAVE
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
            display-name = "LAYER0";
            label = "默认层";
        };

        Navigation {
            bindings = <
&trans  &trans    &trans        &trans      &trans     &trans    &trans  &trans     &trans            &trans             &trans             &trans  &trans
&trans  &trans    &kp LEFT_GUI  &kp DELETE  &trans     &trans    &trans  &kp PG_UP  &kp HOME          &kp UP             &kp END            &trans  &trans
&trans  &kp LALT  &mo 3         &kp LSHFT   &kp LCTRL  &trans    &trans  &kp PG_DN  &kp LEFT          &kp DOWN           &kp RIGHT          &trans  &trans
&trans  &trans    &trans        &trans      &trans     &trans    &trans  &kp LC(Z)  &kp LC(LS(LEFT))  &kp K_APPLICATION  &kp LC(LS(RIGHT))  &trans  &trans
&trans  &trans    &trans        &trans      &trans     &trans    &trans  &trans     &trans            &to 0              &trans             &trans
            >;

            label = "导航";
        };

        Number {
            bindings = <
&trans  &trans     &kp E   &kp COMMA  &kp PERCENT   &trans      &trans  &trans  &trans     &trans     &trans    &trans    &trans
&trans  &kp FSLH   &kp N7  &kp N8     &kp N9        &kp STAR    &trans  &trans  &trans     &kp DOT    &kp RGUI  &trans    &trans
&trans  &kp MINUS  &kp N4  &kp N5     &kp N6        &kp N0      &trans  &trans  &kp RCTRL  &kp RSHFT  &mo 3     &kp RALT  &trans
&trans  &kp X      &kp N1  &kp N2     &kp NUMBER_3  &kp PLUS    &trans  &trans  &trans     &trans     &kp RALT  &trans    &trans
&trans  &trans     &trans  &trans     &trans        &trans      &trans  &trans  &trans     &to 0      &trans    &trans
            >;

            label = "数字";
        };

        Symbols {
            bindings = <
&trans  &trans           &trans         &trans            &trans             &trans           &trans  &trans     &trans                &trans                 &trans         &trans             &trans
&trans  &kp GRAVE        &kp LESS_THAN  &kp GREATER_THAN  &kp MINUS          &kp PIPE         &trans  &kp AT     &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp DLLR       &kp UNDER          &trans
&trans  &kp EXCLAMATION  &kp STAR       &kp FSLH          &kp EQUAL          &kp AMPERSAND    &trans  &kp HASH   &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp SEMICOLON  &kp DOUBLE_QUOTES  &trans
&trans  &kp TILDE        &kp PLUS       &kp LBKT          &kp RIGHT_BRACKET  &kp PERCENT      &trans  &kp COLON  &kp CARET             &kp QUESTION           &kp EXCL       &kp SQT            &trans
&trans  &trans           &trans         &trans            &trans             &trans           &trans  &trans     &trans                &to 0                  &trans         &trans
            >;

            label = "符号";
        };

        Fkey {
            bindings = <
&trans  &trans        &trans             &trans           &trans            &trans    &trans  &trans   &trans  &kp SCROLLLOCK  &kp SYSREQ  &trans  &trans
&trans  &trans        &kp LEFT_GUI       &bt BT_NXT       &bt BT_PRV        &trans    &trans  &kp F12  &kp F7  &kp F8          &kp F9      &trans  &trans
&trans  &kp LEFT_ALT  &kp C_MUTE         &kp LEFT_SHIFT   &kp LEFT_CONTROL  &trans    &trans  &kp F10  &kp F4  &kp F5          &kp F6      &trans  &trans
&trans  &trans        &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &trans            &trans    &trans  &kp F11  &kp F1  &kp F2          &kp F3      &trans  &trans
&trans  &trans        &trans             &trans           &trans            &trans    &trans  &trans   &trans  &to 0           &trans      &trans
            >;

            label = "功能区和鼠标";
        };

        Functions {
            bindings = <
&trans  &to 1   &to 2            &to 3            &to 4         &to 5             &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &bt BT_SEL 3     &bt BT_SEL 4     &soft_off     &bt BT_CLR_ALL    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2  &bt BT_CLR        &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &rgb_ug RGB_EFF  &rgb_ug RGB_TOG  &trans        &trans            &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans           &trans           &trans        &trans            &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
